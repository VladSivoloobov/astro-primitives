---
import type { HTMLAttributes } from 'astro/types';
import tv, { type VariantProps } from '../../utils/tv';

const card = tv({
  base: 'rounded-xl border border-border bg-background text-foreground shadow-sm',
  variants: {
    padding: {
      none: 'p-0',
      sm: 'p-4',
      default: 'p-6',
      lg: 'p-8',
    },
  },
  defaultVariants: {
    padding: 'default',
  },
});

type Props = HTMLAttributes<'div'> & VariantProps<typeof card>;

const { padding, class: className, ...attributes }: Props = Astro.props;
---

<div class={card({ padding, class: className })} {...attributes}>
  <slot />
</div>
