---
import type { HTMLAttributes } from 'astro/types';
import tv, { type VariantProps } from '../../utils/tv';

const input = tv({
  base: 'flex w-full rounded-md border border-border bg-background text-foreground placeholder:text-foreground/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50',
  variants: {
    size: {
      sm: 'h-8 px-3 text-sm',
      default: 'h-10 px-3 text-sm',
      lg: 'h-12 px-4',
    },
    invalid: {
      true: 'border-destructive focus-visible:ring-destructive',
    },
  },
  defaultVariants: {
    size: 'default',
    invalid: false,
  },
});

type Props = HTMLAttributes<'input'> & VariantProps<typeof input>;

const {
  size,
  invalid,
  class: className,
  ...attributes
}: Props = Astro.props;
---

<input
  class={input({ size, invalid, class: className })}
  aria-invalid={invalid || undefined}
  {...attributes}
/>
