---
import type { HTMLAttributes } from 'astro/types';
import tv, { type VariantProps } from '../../utils/tv';

const title = tv({
  base: 'scroll-mt-20 font-semibold tracking-tight text-foreground',
  variants: {
    level: {
      h1: 'text-4xl md:text-5xl',
      h2: 'text-3xl md:text-4xl',
      h3: 'text-2xl md:text-3xl',
      h4: 'text-xl md:text-2xl',
      h5: 'text-lg md:text-xl',
      h6: 'text-base md:text-lg',
    },
    align: {
      left: 'text-left',
      center: 'text-center',
      right: 'text-right',
    },
    weight: {
      default: 'font-semibold',
      medium: 'font-medium',
      bold: 'font-bold',
    },
  },
  defaultVariants: {
    level: 'h2',
    align: 'left',
    weight: 'default',
  },
});

type HeadingLevel = 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';

type Props = HTMLAttributes<'h1'> &
  VariantProps<typeof title> & {
    as?: HeadingLevel;
  };

const {
  as,
  level = 'h2',
  align,
  weight,
  class: className,
  ...attributes
}: Props = Astro.props;

const Component = as ?? level;
---

<Component
  class={title({ level, align, weight, class: className })}
  {...attributes}
>
  <slot />
</Component>
