---
import type { HTMLAttributes } from 'astro/types';
import tv, { type VariantProps } from '../../utils/tv';

const gridLayout = tv({
  base: 'grid',
  variants: {
    columns: {
      1: 'grid-cols-1',
      2: 'grid-cols-2',
      3: 'grid-cols-3',
      4: 'grid-cols-4',
      5: 'grid-cols-5',
      6: 'grid-cols-6',
    },
    gap: {
      none: 'gap-0',
      sm: 'gap-2',
      default: 'gap-4',
      lg: 'gap-8',
    },
  },
  defaultVariants: {
    columns: 2,
    gap: 'default',
  },
});

type Props = HTMLAttributes<'div'> &
  VariantProps<typeof gridLayout> & {
    as?: 'div' | 'ul' | 'ol';
  };

const {
  as: Element = 'div',
  columns,
  gap,
  class: className,
  ...attributes
}: Props = Astro.props;
---

<Element class={gridLayout({ columns, gap, class: className })} {...attributes}>
  <slot />
</Element>
